<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro - Tableau de bord</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="h-full flex flex-col font-sans text-slate-800">

  <!-- Navbar -->
  <header class="bg-indigo-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl font-black tracking-wider text-indigo-400">SportConnect<span class="text-white">Pro</span></span>
        <span class="text-xs bg-indigo-800 text-indigo-200 px-2 py-0.5 rounded font-mono">Municipal OS</span>
      </div>
      <nav class="flex space-x-4 text-sm font-medium">
        <a href="/" class="text-white bg-indigo-800 px-3 py-1.5 rounded-md">Tableau de bord</a>
        <a href="/activities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Activités</a>
        <a href="/facilities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Installations</a>
        <a href="/members" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Adhérents</a>
        <a href="/registrations" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Inscriptions</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Hero Banner -->
    <div class="bg-gradient-to-r from-indigo-700 to-blue-600 rounded-2xl p-6 md:p-8 text-white shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold">Gestionnaire des Installations Sportives</h1>
        <p class="text-indigo-100 text-sm mt-1">Supervision en temps réel des plannings, salles ERP et inscriptions associatives.</p>
      </div>
      <div class="flex gap-3">
        <a href="/registrations/new" class="bg-white text-indigo-700 hover:bg-indigo-50 font-semibold px-4 py-2 rounded-lg text-sm shadow transition">
          <i class="fa-solid fa-plus mr-1.5"></i> Nouvelle Inscription
        </a>
      </div>
    </div>

    <!-- KPIs Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- Total Activities -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Activités</p>
          <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= typeof stats !== 'undefined' ? stats.activities : 0 %></p>
        </div>
        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-lg flex items-center justify-center text-xl">
          <i class="fa-solid fa-calendar-check"></i>
        </div>
      </div>

      <!-- Facilities -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Installations</p>
          <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= typeof stats !== 'undefined' ? stats.facilities : 0 %></p>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center text-xl">
          <i class="fa-solid fa-building"></i>
        </div>
      </div>

      <!-- Members -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Adhérents</p>
          <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= typeof stats !== 'undefined' ? stats.members : 0 %></p>
        </div>
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center text-xl">
          <i class="fa-solid fa-users"></i>
        </div>
      </div>

      <!-- Inscriptions Confirmées -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Inscriptions</p>
          <p class="text-3xl font-extrabold text-emerald-600 mt-1"><%= typeof stats !== 'undefined' ? stats.confirmedRegistrations : 0 %></p>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center text-xl">
          <i class="fa-solid fa-circle-check"></i>
        </div>
      </div>

    </div>

    <!-- Main Grid: Recent Activities + Quick Shortcuts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Table: Recent Activities (2 Cols) -->
      <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex justify-between items-center">
          <h2 class="font-bold text-slate-800 text-lg">Activités Récentes</h2>
          <a href="/activities" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">Voir tout &rarr;</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 border-b border-slate-100 font-semibold">
              <tr>
                <th class="px-5 py-3">Activité</th>
                <th class="px-5 py-3">Installation</th>
                <th class="px-5 py-3">Jour / Horaire</th>
                <th class="px-5 py-3 text-right">Capacité</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (typeof stats !== 'undefined' && stats.recentActivities && stats.recentActivities.length > 0) { %>
                <% stats.recentActivities.forEach(function(act) { %>
                  <tr class="hover:bg-slate-50 transition">
                    <td class="px-5 py-3.5 font-medium text-slate-900"><%= act.name %></td>
                    <td class="px-5 py-3.5 text-slate-600"><%= act.facility_name || '—' %></td>
                    <td class="px-5 py-3.5 text-slate-600">
                      <%= act.day_of_week || act.day || '—' %> 
                      <%= (act.start_time && act.end_time) ? '(' + act.start_time.slice(0, 5) + ' - ' + act.end_time.slice(0, 5) + ')' : '' %>
                    </td>
                    <td class="px-5 py-3.5 text-right">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
                        Max <%= act.max_capacity || act.capacity || 20 %> pers.
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="px-5 py-6 text-center text-slate-400">Aucune activité enregistrée.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Quick Actions Sidebar (1 Col) -->
      <div class="space-y-6">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
          <h2 class="font-bold text-slate-800 text-lg mb-4">Raccourcis Opérationnels</h2>
          <div class="space-y-3">
            <a href="/registrations/new" class="flex items-center p-3 rounded-lg border border-slate-100 hover:border-indigo-200 hover:bg-indigo-50/50 transition group">
              <div class="w-9 h-9 rounded-md bg-indigo-100 text-indigo-600 flex items-center justify-center mr-3 group-hover:bg-indigo-600 group-hover:text-white transition">
                <i class="fa-solid fa-clipboard-check text-sm"></i>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-800">Inscrire un Adhérent</p>
                <p class="text-xs text-slate-400">Affectation & tarif municipal</p>
              </div>
            </a>

            <a href="/members" class="flex items-center p-3 rounded-lg border border-slate-100 hover:border-blue-200 hover:bg-blue-50/50 transition group">
              <div class="w-9 h-9 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center mr-3 group-hover:bg-blue-600 group-hover:text-white transition">
                <i class="fa-solid fa-user-plus text-sm"></i>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-800">Gestion des Adhérents</p>
                <p class="text-xs text-slate-400">Fiches médicales & résidents</p>
              </div>
            </a>

            <a href="/facilities" class="flex items-center p-3 rounded-lg border border-slate-100 hover:border-emerald-200 hover:bg-emerald-50/50 transition group">
              <div class="w-9 h-9 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center mr-3 group-hover:bg-emerald-600 group-hover:text-white transition">
                <i class="fa-solid fa-landmark text-sm"></i>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-800">Installations ERP</p>
                <p class="text-xs text-slate-400">Conformité et capacités des salles</p>
              </div>
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

</body>
</html>