<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SportConnect Pro - Nouvelle Installation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="h-full flex flex-col font-sans text-slate-800">

    <header class="bg-indigo-900 text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-2xl font-black tracking-wider text-indigo-400">SportConnect<span
                        class="text-white">Pro</span></span>
                <span class="text-xs bg-indigo-800 text-indigo-200 px-2 py-0.5 rounded font-mono">Municipal OS</span>
            </div>
            <nav class="flex space-x-4 text-sm font-medium">
                <a href="/" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Tableau de bord</a>
                <a href="/activities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Activités</a>
                <a href="/facilities" class="text-white bg-indigo-800 px-3 py-1.5 rounded-md">Installations</a>
                <a href="/members" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Adhérents</a>
                <a href="/registrations"
                    class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Inscriptions</a>
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Nouvelle Installation</h1>
                <p class="text-sm text-slate-500 mt-1">Enregistrer un complexe ou une salle sportive avec sa jauge ERP.
                </p>
            </div>
            <a href="/facilities"
                class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900 bg-white border border-slate-200 px-4 py-2 rounded-lg shadow-sm transition">
                <i class="fa-solid fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
            <form method="POST" action="/facilities" class="space-y-6">

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nom de l'installation</label>
                    <input type="text" name="name" required placeholder="Ex: Gymnase Municipal Al Massira"
                        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Capacité maximale ERP (Jauge de
                            sécurité)</label>
                        <input type="number" name="erp_capacity" required min="1" placeholder="Ex: 50"
                            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Adresse de
                            l'installation</label>
                        <input type="text" name="address" required placeholder="Ex: Rue Mohammed V, Complexe Omnisport"
                            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                    <a href="/facilities"
                        class="px-5 py-2.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
                        Annuler
                    </a>
                    <button type="submit"
                        class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg shadow-sm transition">
                        <i class="fa-solid fa-floppy-disk"></i> Enregistrer l'installation
                    </button>
                </div>

            </form>
        </div>

    </main>

</body>

</html>