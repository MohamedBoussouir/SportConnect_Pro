<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro - Modifier l'Adhérent</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="h-full flex flex-col font-sans text-slate-800">

  <!-- Header / Navbar -->
  <header class="bg-indigo-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl font-black tracking-wider text-indigo-400">SportConnect<span class="text-white">Pro</span></span>
        <span class="text-xs bg-indigo-800 text-indigo-200 px-2 py-0.5 rounded font-mono">Municipal OS</span>
      </div>
      <nav class="flex space-x-4 text-sm font-medium">
        <a href="/" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Tableau de bord</a>
        <a href="/activities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Activités</a>
        <a href="/facilities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Installations</a>
        <a href="/members" class="text-white bg-indigo-800 px-3 py-1.5 rounded-md">Adhérents</a>
        <a href="/registrations" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Inscriptions</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header Section -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Modifier l'Adhérent #<%= member.id %></h1>
        <p class="text-sm text-slate-500 mt-1">Mettre à jour les informations du dossier citoyen.</p>
      </div>
      <a href="/members" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-indigo-600 bg-white border border-slate-200 px-3.5 py-2 rounded-lg shadow-sm transition">
        <i class="fa-solid fa-arrow-left"></i> Annuler
      </a>
    </div>

    <!-- Form Box -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form method="POST" action="/members/<%= member.id %>/update" class="space-y-6">

        <!-- Nom et Prénom -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Prénom</label>
            <input type="text" name="first_name" value="<%= member.first_name %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nom</label>
            <input type="text" name="last_name" value="<%= member.last_name %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>
        </div>

        <!-- Date de naissance et Date du certificat médical -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Date de naissance</label>
            <% 
              let birthDateVal = '';
              if (member.birth_date) {
                birthDateVal = new Date(member.birth_date).toISOString().split('T')[0];
              }
            %>
            <input type="date" name="birth_date" value="<%= birthDateVal %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Date du certificat médical</label>
            <% 
              let certDateVal = '';
              if (member.medical_cert_date) {
                certDateVal = new Date(member.medical_cert_date).toISOString().split('T')[0];
              }
            %>
            <input type="date" name="medical_cert_date" value="<%= certDateVal %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>
        </div>

        <!-- Statut de résidence et Pass'Sport -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Statut de résidence municipale</label>
            <select name="is_resident" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
              <option value="true" <%= member.is_resident ? 'selected' : '' %>>Résident de la commune (Tarif préférentiel)</option>
              <option value="false" <%= !member.is_resident ? 'selected' : '' %>>Non-résident (Tarif standard)</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Bénéficiaire Pass'Sport</label>
            <select name="has_pass_sport" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
              <option value="false" <%= !member.has_pass_sport ? 'selected' : '' %>>Non</option>
              <option value="true" <%= member.has_pass_sport ? 'selected' : '' %>>Oui</option>
            </select>
          </div>
        </div>

        <!-- Boutons d'action -->
        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
          <a href="/members" class="px-5 py-2.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
            Annuler
          </a>
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition">
            <i class="fa-solid fa-check"></i> Enregistrer les modifications
          </button>
        </div>

      </form>
    </div>

  </main>

</body>
</html>