<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro - Nouvelle Inscription</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="h-full flex flex-col font-sans text-slate-800">

  <!-- Header / Navbar -->
  <header class="bg-indigo-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl font-black tracking-wider text-indigo-400">SportConnect<span class="text-white">Pro</span></span>
        <span class="text-xs bg-indigo-800 text-indigo-200 px-2 py-0.5 rounded font-mono">Municipal OS</span>
      </div>
      <nav class="flex space-x-4 text-sm font-medium">
        <a href="/" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Tableau de bord</a>
        <a href="/activities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Activités</a>
        <a href="/facilities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Installations</a>
        <a href="/members" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Adhérents</a>
        <a href="/registrations" class="text-white bg-indigo-800 px-3 py-1.5 rounded-md">Inscriptions</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header Section -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Nouvelle Inscription</h1>
        <p class="text-sm text-slate-500 mt-1">Associer un adhérent à une activité sportive municipale.</p>
      </div>
      <a href="/registrations" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-indigo-600 bg-white border border-slate-200 px-3.5 py-2 rounded-lg shadow-sm transition">
        <i class="fa-solid fa-arrow-left"></i> Retour aux inscriptions
      </a>
    </div>

    <!-- Alert / Notice Box -->
    <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-4 flex gap-3 items-start">
      <i class="fa-solid fa-circle-info text-indigo-600 mt-0.5 text-base"></i>
      <div class="text-xs text-indigo-900 leading-relaxed">
        <span class="font-bold">Règles municipales d'inscription :</span> Le tarif final sera automatiquement calculé selon le statut de résidence et le Pass'Sport de l'adhérent. La validité du certificat médical sera vérifiée lors de l'enregistrement.
      </div>
    </div>

    <!-- Form Box -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form method="POST" action="/registrations" class="space-y-6">

        <!-- Sélection de l'Adhérent -->
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Sélectionner l'adhérent</label>
          <select name="member_id" required class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
            <option value="" disabled selected>-- Choisissez un adhérent --</option>
            <% if (typeof members !== 'undefined' && members.length > 0) { %>
              <% members.forEach(function(m) { %>
                <option value="<%= m.id %>">
                  #<%= m.id %> - <%= m.first_name %> <%= m.last_name %> (<%= m.is_resident ? 'Résident' : 'Non-résident' %><%= m.has_pass_sport ? ', Pass\'Sport' : '' %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Sélection de l'Activité -->
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Activité sportive</label>
          <select name="activity_id" required class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
            <option value="" disabled selected>-- Choisissez une activité --</option>
            <% if (typeof activities !== 'undefined' && activities.length > 0) { %>
              <% activities.forEach(function(a) { %>
                <option value="<%= a.id %>">
                  <%= a.name %><%= a.facility_name ? ' — ' + a.facility_name : '' %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Statut de l'inscription -->
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Statut de l'inscription</label>
          <select name="status" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
            <option value="CONFIRMED" selected>Confirmée (Dossier complet)</option>
            <option value="PENDING">En attente (Paiement ou pièce justificative)</option>
          </select>
        </div>

        <!-- Boutons d'action -->
        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
          <a href="/registrations" class="px-5 py-2.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
            Annuler
          </a>
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition">
            <i class="fa-solid fa-clipboard-check"></i> Valider l'inscription
          </button>
        </div>

      </form>
    </div>

  </main>

</body>
</html>