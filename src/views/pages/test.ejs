<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro - Test Upload de Fichier</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="h-full flex flex-col font-sans text-slate-800">

  <main class="flex-1 max-w-2xl w-full mx-auto px-4 py-12 space-y-6">

    <div class="border-b border-slate-200 pb-4 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Upload de Fichier (Test)</h1>
        <p class="text-sm text-slate-500 mt-1">Tester le transfert binaire en flux continu (Streams & Chunks).</p>
      </div>
      <a href="/" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-left"></i> Accueil
      </a>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <!-- enctype="multipart/form-data" est indispensable pour les fichiers -->
      <form method="POST" action="/test" enctype="multipart/form-data" class="space-y-6">

        <div>
          <label for="titre" class="block text-sm font-semibold text-slate-700 mb-1.5">Titre du document</label>
          <input 
            type="text" 
            id="titre" 
            name="titre" 
            placeholder="Ex : Certificat médical 2026" 
            required 
            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
          >
        </div>

        

        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
          <button 
            type="submit" 
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition"
          >
            <i class="fa-solid fa-upload"></i> Envoyer le flux
          </button>
        </div>

      </form>
    </div>

  </main>

  

</body>
</html>