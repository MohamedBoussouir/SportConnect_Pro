<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportConnect Pro - Modifier Activité</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="h-full flex flex-col font-sans text-slate-800">

  <header class="bg-indigo-900 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl font-black tracking-wider text-indigo-400">SportConnect<span class="text-white">Pro</span></span>
        <span class="text-xs bg-indigo-800 text-indigo-200 px-2 py-0.5 rounded font-mono">Municipal OS</span>
      </div>
      <nav class="flex space-x-4 text-sm font-medium">
        <a href="/" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Tableau de bord</a>
        <a href="/activities" class="text-white bg-indigo-800 px-3 py-1.5 rounded-md">Activités</a>
        <a href="/facilities" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Installations</a>
        <a href="/members" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Adhérents</a>
        <a href="/registrations" class="text-indigo-200 hover:text-white px-3 py-1.5 transition">Inscriptions</a>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <% 
      // استخراج العنصر الأول إذا كان المتغير مصفوفة
      const item = Array.isArray(test) ? test[0] : test; 
    %>

    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Modifier l'Activité</h1>
        <p class="text-sm text-slate-500 mt-1">Mettre à jour les informations du créneau sportif.</p>
      </div>
      <a href="/activities" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-indigo-600 bg-white border border-slate-200 px-3.5 py-2 rounded-lg shadow-sm transition">
        <i class="fa-solid fa-arrow-left"></i> Retour à la liste
      </a>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
      <form method="post" action="/activities/<%= item.id %>/update" class="space-y-6">
        
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nom de l'activité</label>
          <input type="text" name="name" value="<%= item.name %>" required placeholder="Ex: Basket-ball U17" 
            class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tarif de base (MAD)</label>
            <input type="number" step="0.01" name="base_price" value="<%= item.base_price %>" required placeholder="Ex: 150.00" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Capacité ERP (Max places)</label>
            <input type="number" name="max_capacity" value="<%= item.max_capacity %>" required placeholder="Ex: 20" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Jour de la semaine</label>
            <select name="day_of_week" class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm bg-white">
              <% const days = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche']; %>
              <% days.forEach(d => { %>
                <option value="<%= d %>" <%= item.day_of_week === d ? 'selected' : '' %>><%= d %></option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Heure de début</label>
            <input type="time" name="start_time" value="<%= item.start_time ? item.start_time.slice(0, 5) : '' %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Heure de fin</label>
            <input type="time" name="end_time" value="<%= item.end_time ? item.end_time.slice(0, 5) : '' %>" required 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
          <a href="/activities" class="px-5 py-2.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition">
            Annuler
          </a>
          <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition">
            <i class="fa-solid fa-check"></i> Enregistrer les modifications
          </button>
        </div>

      </form>
    </div>

  </main>

</body>
</html>